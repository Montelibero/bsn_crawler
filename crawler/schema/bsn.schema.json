{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BSN public snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "createDate",
    "knownTokens",
    "usedSources",
    "accounts"
  ],
  "properties": {
    "createDate": {
      "type": "string",
      "format": "date-time"
    },
    "knownTokens": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/assetCode"
      },
      "additionalProperties": {
        "$ref": "#/$defs/knownToken"
      }
    },
    "usedSources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]{1,12}-G[A-Z2-7]{55}$"
      }
    },
    "accounts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/accountId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/account"
      }
    }
  },
  "$defs": {
    "accountId": {
      "type": "string",
      "pattern": "^G[A-Z2-7]{55}$"
    },
    "assetCode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,12}$"
    },
    "tagName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$"
    },
    "stringValues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knownToken": {
      "type": "object",
      "required": [
        "issuer"
      ],
      "properties": {
        "issuer": {
          "$ref": "#/$defs/accountId"
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/tagName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/stringValues"
      }
    },
    "balances": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/assetCode"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
      }
    },
    "tags": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/tagName"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/accountId"
        }
      }
    },
    "signatures": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "additionalProperties": {
        "$comment": "Integer labels preserve the current PHP behavior for numeric ManageData keys.",
        "type": [
          "string",
          "integer"
        ]
      }
    },
    "signer": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/accountId"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      ],
      "items": false
    },
    "multisig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thresholds",
        "master_key",
        "signers"
      ],
      "properties": {
        "thresholds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "master_key": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "signers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/signer"
          }
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "balances"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "balances": {
          "$ref": "#/$defs/balances"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "signatures": {
          "$ref": "#/$defs/signatures"
        },
        "multisig": {
          "$ref": "#/$defs/multisig"
        }
      }
    }
  }
}
